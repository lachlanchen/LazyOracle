# Tianji Cloud relay providers. Copy to /etc/lazyoracle/gateway.env on the web
# host (root:lazyoracle-web, mode 640) and fill in. With none set the relay
# answers 503 and the app falls back to its offline composition.
#
# Tiers: the app asks for tianji-fast (天机快速版) or tianji-pro (天机专业版);
# each provider maps the tier to one of its own models.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# Used for any reading that carries a photo; the Pro model takes text only.
DEEPSEEK_MODEL_VISION=deepseek-flash

# A LazyEdge (workstation) OpenAI-compatible chat-completions URL, used when
# DeepSeek is unset or fails.
LAZYEDGE_URL=
LAZYEDGE_TOKEN=
LAZYEDGE_MODEL_FAST=
LAZYEDGE_MODEL_PRO=
LAZYEDGE_MODEL_VISION=

# Optional report service. Keep real values in a protected separate env file.
# One authoritative ledger on oracle.lazying.art, shared by all clients.
ORACLE_REPORT_DB=/var/lib/lazyoracle/reports.sqlite
ORACLE_NODE=/usr/local/bin/node
ORACLE_APPLE_ROOTS=/etc/lazyoracle/billing/apple-roots
ORACLE_APPLE_APP_ID=6814663937
ORACLE_APPLE_KEY_FILE=/etc/lazyoracle/billing/apple-iap.p8
ORACLE_APPLE_KEY_ID=
ORACLE_APPLE_ISSUER_ID=
ORACLE_GOOGLE_CREDENTIALS=/etc/lazyoracle/billing/google-play.json
ORACLE_STRIPE_SECRET=
ORACLE_STRIPE_PRICE=
ORACLE_STRIPE_WEBHOOK=
ORACLE_WEB_ORIGIN=https://oracle.lazying.art
